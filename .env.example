# =============================================================================
# TEST AUTOMATION FRAMEWORK - ENVIRONMENT CONFIGURATION
# =============================================================================
# This file serves as a template for environment variables required by the
# pytest-based test automation framework with MCP integration, Playwright,
# and LLM-assisted test generation capabilities.
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env in the project root
# 2. Update values to match your environment
# 3. Never commit .env with actual secrets to version control
# =============================================================================

# =============================================================================
# APPLICATION UNDER TEST - BASE URLs
# =============================================================================
# Web application base URL for Playwright UI tests
# Used by: Page objects, browser navigation, pytest-playwright base_url fixture
BASE_URL=http://localhost:3000

# REST API base URL for httpx API tests
# Used by: API clients, httpx fixtures, integration tests
API_BASE_URL=http://localhost:8000/api/v1

# =============================================================================
# PLAYWRIGHT BROWSER CONFIGURATION
# =============================================================================
# Run browser in headless mode (no visible window)
# Set to false for debugging and development
# Used by: pytest-playwright fixtures, CI/CD pipelines
HEADLESS=true

# Default browser engine to use
# Options: chromium, firefox, webkit
# Can be overridden per-test or via pytest CLI: pytest --browser firefox
BROWSER=chromium

# Slow down Playwright operations (milliseconds)
# Useful for debugging to see actions in real-time
# Set to 0 for full speed (recommended for CI)
SLOW_MO=0

# Default timeout for Playwright operations (milliseconds)
# Applies to: locator waits, navigation, assertions
TIMEOUT=30000

# Default navigation timeout (milliseconds)
# Specific timeout for page.goto() operations
NAVIGATION_TIMEOUT=30000

# Screenshot capture strategy
# Options: on, off, only-on-failure
# Used by: pytest-playwright plugin, test failure debugging
SCREENSHOTS=only-on-failure

# Video recording for test execution
# Options: on, off, retain-on-failure, on-first-retry
# Warning: Video recording impacts performance
CAPTURE_VIDEO=retain-on-failure

# Trace capture for debugging (Playwright Inspector)
# Options: on, off, retain-on-failure, on-first-retry
# Traces provide detailed execution timeline with DOM snapshots
CAPTURE_TRACE=on-first-retry

# Viewport size for browser window
# Format: WIDTHxHEIGHT
VIEWPORT_SIZE=1920x1080

# Device emulation (optional)
# Leave empty for desktop, or specify: iPhone 12, Pixel 5, iPad Pro, etc.
# See: https://github.com/microsoft/playwright/blob/main/packages/playwright-core/src/server/deviceDescriptorsSource.json
DEVICE_EMULATION=

# =============================================================================
# FASTAPI MCP SERVER - PRODUCTION/CI (Deterministic Test Data)
# =============================================================================
# MCP server endpoint for test data management tools
# Provides: seed_user, build_payload, reset_env, query_state
# Started in CI pipeline before test execution
FASTAPI_MCP_URL=http://localhost:8001

# Authentication token for MCP server access
# Required for all MCP tool calls from tests
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FASTAPI_MCP_TOKEN=your-secret-mcp-token-change-in-production

# Target application database URL for user seeding
# MCP server uses this to create test users and manage state
# Examples:
#   SQLite: sqlite:///./test_data.db
#   PostgreSQL: postgresql://user:password@localhost:5432/testdb
#   MySQL: mysql+pymysql://user:password@localhost:3306/testdb
APP_DATABASE_URL=sqlite:///./test_data.db

# Enable MCP server in test runs
# Set to false to skip MCP server dependency (uses hardcoded test data)
FASTAPI_MCP_ENABLED=true

# =============================================================================
# PLAYWRIGHT MCP SERVER - DEVELOPMENT ONLY (LLM Exploration)
# =============================================================================
# MCP server endpoint for LLM-driven browser exploration
# Provides: navigate, click, type, screenshot, get_page_structure, generate_gherkin
# Used for: exploratory testing, automated scenario discovery
PLAYWRIGHT_MCP_URL=http://localhost:8002

# Enable Playwright MCP server (development only)
# Set to true for LLM-assisted test generation workflows
# Always false in CI unless explicitly needed
PLAYWRIGHT_MCP_ENABLED=false

# =============================================================================
# LLM INTEGRATION - TEST GENERATION AND SUGGESTIONS
# =============================================================================
# LLM provider selection
# Options: ollama (local), openai (hosted), azure (Azure OpenAI)
LLM_PROVIDER=ollama

# Model name/identifier
# Ollama examples: llama3.2, llama3.1, codellama, mistral, mixtral
# OpenAI examples: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# Azure: deployment name from Azure OpenAI Studio
LLM_MODEL=llama3.2

# API key for hosted LLM services
# Required for: OpenAI, Azure OpenAI, Anthropic
# Not needed for: Ollama (local)
# IMPORTANT: Never commit actual API keys - use secrets management
LLM_API_KEY=

# LLM API base URL
# Ollama default: http://localhost:11434
# OpenAI: https://api.openai.com/v1
# Azure: https://<resource>.openai.azure.com/
# Custom endpoints: Any OpenAI-compatible API
LLM_BASE_URL=http://localhost:11434

# LLM request timeout (seconds)
LLM_TIMEOUT=60

# Enable LLM-assisted features
# Set to false to disable all LLM integration
LLM_ENABLED=false

# =============================================================================
# PYTEST EXECUTION CONFIGURATION
# =============================================================================
# Number of parallel test workers
# Options: auto (CPU count), integer (specific count), 1 (no parallelism)
# Used by: pytest-xdist plugin
PYTEST_WORKERS=auto

# Test execution timeout per test (seconds)
# Tests exceeding this duration will be terminated
# Used by: pytest-timeout plugin
TEST_TIMEOUT=300

# Pytest verbosity level
# Options: 0 (quiet), 1 (default), 2 (verbose), 3 (very verbose)
PYTEST_VERBOSITY=1

# Fail fast - stop after N failures
# Set to 1 to stop after first failure (useful for debugging)
# Set to 0 to run all tests regardless of failures
PYTEST_MAXFAIL=0

# Test discovery patterns
# pytest will discover tests matching these patterns
PYTEST_PATTERN=test_*.py

# =============================================================================
# ALLURE REPORTING
# =============================================================================
# Directory for Allure JSON results
# Generated during test execution with --alluredir flag
ALLURE_RESULTS_DIR=allure-results

# Directory for generated Allure HTML report
# Created with: allure generate allure-results -o allure-report
ALLURE_REPORT_DIR=allure-report

# Allure report history retention (number of builds)
# Set to 0 for unlimited history
ALLURE_HISTORY_LIMIT=10

# Clean results directory before test run
# Options: true, false
ALLURE_CLEAN_RESULTS=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Application log level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Detailed information for diagnosis
# INFO: General informational messages (recommended for dev)
# WARNING: Warning messages only
# ERROR: Error messages only
# CRITICAL: Critical errors only
LOG_LEVEL=INFO

# Log output format
# Options: json, text, colored
LOG_FORMAT=colored

# Log file path (optional)
# Leave empty to disable file logging
LOG_FILE=

# =============================================================================
# CI/CD ENVIRONMENT FLAGS
# =============================================================================
# Running in CI environment
# Automatically set by CI providers (GitHub Actions, Jenkins, etc.)
# Used for: conditional behavior, reporting, resource optimization
CI=false

# GitHub Actions specific flag
# Automatically set to true in GitHub Actions workflows
GITHUB_ACTIONS=false

# =============================================================================
# AUTHENTICATION - TEST USER CREDENTIALS
# =============================================================================
# Standard test user credentials (customer/basic role)
TEST_USER_EMAIL=test.user@example.com
TEST_USER_PASSWORD=TestUser123!

# Admin test user credentials (administrative access)
TEST_ADMIN_EMAIL=test.admin@example.com
TEST_ADMIN_PASSWORD=TestAdmin123!

# Guest test user (limited/read-only access)
TEST_GUEST_EMAIL=test.guest@example.com
TEST_GUEST_PASSWORD=TestGuest123!

# Test user with special characters (edge case testing)
TEST_SPECIAL_USER_EMAIL=test+special@example.com
TEST_SPECIAL_USER_PASSWORD=P@ssw0rd!Special#123

# =============================================================================
# NETWORK AND RETRY CONFIGURATION
# =============================================================================
# HTTP request timeout (milliseconds)
# Used by: httpx clients, API tests
REQUEST_TIMEOUT=30000

# Maximum retry attempts for flaky operations
# Used by: tenacity retry decorators, custom retry logic
MAX_RETRIES=3

# Delay between retry attempts (milliseconds)
RETRY_DELAY=1000

# Exponential backoff multiplier for retries
# Delay will be: RETRY_DELAY * (RETRY_BACKOFF_MULTIPLIER ^ attempt)
RETRY_BACKOFF_MULTIPLIER=2

# =============================================================================
# TEST DATA AND STATE MANAGEMENT
# =============================================================================
# Reset environment state before test suite
# Options: true, false
# When true: Calls MCP reset_env before test execution
RESET_ENV_BEFORE_TESTS=true

# Cleanup test data after execution
# Options: true, false
# When true: Removes seeded users and test data after run
CLEANUP_AFTER_TESTS=true

# Test data seed file (optional)
# Path to JSON file with predefined test data
TEST_DATA_SEED_FILE=

# =============================================================================
# FEATURE FLAGS AND EXPERIMENTAL FEATURES
# =============================================================================
# Enable BDD/Gherkin test execution
# Set to false to skip .feature files
BDD_ENABLED=true

# Enable API tests
API_TESTS_ENABLED=true

# Enable UI tests
UI_TESTS_ENABLED=true

# Enable integration/E2E tests
INTEGRATION_TESTS_ENABLED=true

# Enable performance monitoring
# Collects timing metrics for test operations
PERFORMANCE_MONITORING=false

# =============================================================================
# DEVELOPMENT AND DEBUGGING
# =============================================================================
# Pause on test failure (development only)
# When true, execution pauses after failures for inspection
# NEVER set to true in CI
PAUSE_ON_FAILURE=false

# Debug mode - enables additional logging and checks
# Impacts performance, use only for troubleshooting
DEBUG_MODE=false

# Preserve browser context after test (development only)
# When true, browser stays open after test completion
# Useful for manual inspection and debugging
PRESERVE_BROWSER_CONTEXT=false

# =============================================================================
# EXTERNAL SERVICE INTEGRATIONS (Optional)
# =============================================================================
# Slack webhook for test notifications (optional)
SLACK_WEBHOOK_URL=

# Email notifications (optional)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_TO=

# Test report publishing URL (optional)
# For custom report hosting
REPORT_PUBLISH_URL=

# =============================================================================
# SECURITY AND SECRETS MANAGEMENT
# =============================================================================
# Encryption key for sensitive test data (optional)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Secrets provider (optional)
# Options: env (environment variables), vault (HashiCorp Vault), aws (AWS Secrets Manager)
SECRETS_PROVIDER=env

# HashiCorp Vault configuration (if SECRETS_PROVIDER=vault)
VAULT_ADDR=
VAULT_TOKEN=
VAULT_NAMESPACE=

# AWS Secrets Manager configuration (if SECRETS_PROVIDER=aws)
AWS_REGION=us-east-1
AWS_SECRETS_MANAGER_SECRET_ID=

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
