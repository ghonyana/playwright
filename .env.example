# Application URLs
BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Browser Configuration
HEADLESS=true
BROWSER=chromium
SLOW_MO=0

# Test Configuration
PARALLEL_WORKERS=auto
TEST_TIMEOUT=30000

# FastAPI MCP Server Configuration (for deterministic test data)
FASTAPI_MCP_URL=http://localhost:8001
FASTAPI_MCP_TOKEN=your-secret-token-here

# Playwright MCP Server Configuration (development/exploration only)
PLAYWRIGHT_MCP_URL=http://localhost:8002
PLAYWRIGHT_MCP_ENABLED=false

# LLM Integration (optional)
LLM_PROVIDER=ollama
# Options: ollama, openai, azure
LLM_MODEL=llama3.2
# For Ollama: llama3.2, codellama, mistral
# For OpenAI: gpt-4, gpt-3.5-turbo
LLM_API_KEY=
# Required for OpenAI/Azure, not needed for Ollama
LLM_API_BASE=http://localhost:11434
# Ollama default: http://localhost:11434
# OpenAI: https://api.openai.com/v1

# Allure Reporting
ALLURE_RESULTS_DIR=allure-results
ALLURE_REPORT_DIR=allure-report

# Database Configuration (for MCP servers)
DATABASE_URL=sqlite:///./test_data.db
# For production: postgresql://user:pass@localhost/dbname

# Logging
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# CI/CD Mode
CI=false
# Set to true in GitHub Actions or other CI environments

# Authentication (test users)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=Test123!
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=Admin123!

# Screenshot and Video Settings
CAPTURE_SCREENSHOT_ON_FAILURE=true
CAPTURE_VIDEO=false
CAPTURE_TRACE=true

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=1000

# Network Configuration
REQUEST_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
